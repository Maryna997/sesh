# Port the Express server listens on
PORT=5000

# Frontend URL(s) allowed to call the API with cookies (CORS + CSRF check).
# No trailing slash. Separate several origins with commas. "*" is not allowed.
CLIENT_URL=http://localhost:5173

# Supabase session pooler connection string (port 5432, not the 6543 transaction pooler).
# Find it in Supabase: Connect > Session pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Required: secret used to sign login tokens. At least 32 random characters,
# different for every environment, never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional: how long a login lasts, in hours (1-720, default 168 = 7 days).
# JWT_EXPIRES_IN_HOURS=168

# Optional: set to "production" on the deployed server. This makes the
# session cookie Secure (HTTPS only).
# NODE_ENV=production

# Optional cookie overrides (defaults are usually right):
# COOKIE_SAME_SITE=lax     # lax (default), strict, or none (none requires HTTPS)
# COOKIE_SECURE=true       # defaults to true only when NODE_ENV=production

# Optional: bcrypt cost factor for password hashing (4-15, default 12).
# Higher is slower and harder to crack. Keep 12 or more outside tests.
# BCRYPT_ROUNDS=12

# Cloudinary account for profile pictures (Cloudinary dashboard > API Keys).
# Keep the secret private: it is only used by this server, never by the frontend.
# Leave all three empty to run locally without uploads (the upload endpoint
# then answers 503). In production they are required.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: a separate database for `npm test` (recommended once real users
# exist). When empty, tests use DATABASE_URL and only touch @sesh-test.invalid
# accounts. Create its tables with `npm run db:migrate:test`.
# TEST_DATABASE_URL=
