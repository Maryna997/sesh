# The frontend currently needs no environment variables.
#
# API requests use relative paths (/api/v1/...). During development, Vite
# forwards /api to the backend at http://localhost:5000 (see vite.config.js).
# To use another backend address, set API_PROXY_TARGET when starting Vite.
#
# Never put secrets in VITE_ variables: they are bundled into browser code.
